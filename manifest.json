{
  "manifest_version": 3,
  "name": "UT Pustaka Downloader Pro",
  "version": "2.1",
  "description": "Download modul pustaka.ut.ac.id super cepat, bersih tanpa watermark UT, auto-batch semua modul, dan jalan di background tab.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://pustaka.ut.ac.id/*"],
  "content_scripts": [
    {
      "matches": ["https://pustaka.ut.ac.id/*"],
      "js": ["lib/jspdf.umd.min.js", "content-script.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UT Pustaka Downloader Pro",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  }
}
